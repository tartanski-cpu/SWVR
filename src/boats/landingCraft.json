{
  "id": "vessel.landing-craft",
  "version": 1,
  "name": "Landing craft",
  "hull": "hull.landing-craft-9m",
  "modules": [
    {
      "socket": "engine",
      "module": "propulsion.diesel-inboard",
      "config": {
        "engine": {
          "powerKw": 150,
          "idleRpm": 600,
          "ratedRpm": 1800,
          "torqueCurve": [[0, 0], [300, 375], [600, 638], [1000, 938], [1300, 990], [1600, 908], [1800, 796], [1900, 450], [1950, 0]],
          "frictionTorque": 40,
          "frictionPerRpm": 0.03,
          "inertia": 1.6,
          "droopRpm": 120,
          "rackRiseRate": 0.45,
          "starterTorque": 280,
          "starterMaxRpm": 160,
          "crankTime": 1.6,
          "startOnlyInNeutral": true,
          "preheatTime": 2.5,
          "preheatHotTime": 0.6,
          "unheatedExtraCrank": 5,
          "coldBelowC": 40,
          "glowCoolRate": 0.25,
          "gearRatio": 1.42,
          "gearEfficiency": 0.97,
          "shiftDelay": 0.6,
          "neutralBand": 0.08,
          "fuel": {"tankL": 300, "startL": 210, "sfcGPerKWh": 205, "partLoadPenalty": 0.3, "densityKgPerL": 0.84, "lowFraction": 0.1, "refuelRateLps": 2.5},
          "thermal": {
            "heatToCoolant": 0.3,
            "lhvMJPerKg": 42.7,
            "heatCapacity": 60,
            "thermostatOpenC": 80,
            "thermostatFullC": 88,
            "exchangerKwPerK": 1.7,
            "baseLossKwPerK": 0.012,
            "faultExchangerFraction": 0.08,
            "alarmC": 95,
            "derateStartC": 100,
            "derateFullC": 110,
            "derateRack": 0.3,
            "shutdownC": 115,
            "oilLagS": 90,
            "oilLoadRiseC": 12
          }
        },
        "propeller": {
          "diameter": 0.55,
          "kt0": 0.57,
          "j0": 1.15,
          "kq0": 0.077,
          "jq0": 1.25,
          "asternEfficiency": 0.5,
          "asternTorque": 0.9,
          "inertia": 0.15,
          "wake": 0.18,
          "thrustDeduction": 0.18,
          "position": [0, -0.35, 4.45],
          "rightHanded": true,
          "propWalkAhead": 0.03,
          "propWalkAstern": 0.12,
          "propWalkFadeSpeed": 1.5
        },
        "sampleAt": [0, -0.3, 4.85],
        "maintenance": {
          "oilStart": 0.72,
          "use": 0.00025,
          "checkEvery": 900,
          "lowAt": 0.4,
          "lampAt": 0.12,
          "engine": {"x": 0.5, "z": 2.65, "length": 0.6, "width": 0.38, "height": 0.45},
          "dipstick": [0.3, 2.45],
          "filler": [0.5, 2.9],
          "oilCan": [0.77, 2.9],
          "shelfDrop": 0.3
        },
        "massKg": 600
      }
    },
    {
      "socket": "rudder",
      "module": "steering.rudder",
      "config": {
        "rudder": {
          "area": 0.3,
          "liftSlope": 2.4,
          "stallDeg": 28,
          "maxAngleDeg": 35,
          "rateDegPerS": null,
          "washFactor": 0.8,
          "washMaxFraction": 0.55,
          "flowStraightening": 0.5,
          "coastSteer": 1.5,
          "coastFadeThrust": 8000,
          "position": [0, -0.3, 4.85]
        },
        "propeller": {"wake": 0.18, "diameter": 0.55}
      }
    },
    {"socket": "fuelTank", "module": "fuel.tank", "config": {"tankL": 300, "startL": 210}},
    {"socket": "batteries", "module": "electrical.battery-bank"},
    {"socket": "bilgePump", "module": "pump.bilge"},
    {"socket": "cabinLight", "module": "light.cabin"},
    {"socket": "horn", "module": "electrical.consumer", "config": {"label": "Horn", "amps": 10, "circuit": null}, "bind": {"on": "horn.sound"}},
    {
      "socket": "wipers",
      "module": "electrical.consumer",
      "config": {"label": "Wiper motor", "amps": 4, "circuit": "instruments"},
      "bind": {"on": "wipers.on"}
    },
    {
      "socket": "helm",
      "module": "console.standard",
      "config": {
        "instrumentsAmps": 2.5,
        "dash": {"front": -0.5, "aft": -0.34, "bottom": 0, "top": 0.41, "halfWidth": 0.88},
        "pedestals": {"x": [0.42, -0.42], "halfWidth": 0.13, "front": -0.08, "aft": 0.3, "floor": -0.95},
        "groups": [
          {"title": "LIGHTS", "x": [-0.88, -0.5], "color": 14200872},
          {"title": "SEARCH", "x": [-0.48, -0.3], "color": 12599338},
          {"title": "ENGINE", "x": [0.42, 0.88], "color": 3840586}
        ],
        "plates": {"front": -0.27, "aft": -0.05},
        "slots": {
          "wheel": {"position": [0, 0.17, 0.12], "rotationDeg": [-22, 0, 0]},
          "throttle": {"position": [0.42, 0.01, 0.17]},
          "navLights": {"position": [-0.84, 0.01, -0.2]},
          "cabinLight": {"position": [-0.7, 0.01, -0.2]},
          "wipers": {"position": [-0.56, 0.01, -0.2]},
          "spotlight": {"position": [-0.39, 0.01, -0.2]},
          "horn": {"position": [-0.18, 0.01, -0.2]},
          "heat": {"position": [0.5, 0.01, -0.18]},
          "start": {"position": [0.63, 0.01, -0.18]},
          "key": {"position": [0.77, 0.01, -0.18]},
          "lamps": {"position": [0.65, 0.015, -0.28]},
          "card": {"position": [0.72, -0.31, 0.005]},
          "spotJoystick": {"position": [-0.42, 0.01, 0.17]},
          "speed": {"position": [-0.6, 0.21, -0.34]},
          "heading": {"position": [-0.2, 0.21, -0.34]},
          "rpm": {"position": [0.2, 0.21, -0.34]},
          "engineMonitor": {"position": [0.6, 0.21, -0.34]}
        }
      },
      "modules": [
        {"socket": "wheel", "module": "control.wheel"},
        {"socket": "throttle", "module": "control.throttle-lever"},
        {
          "socket": "navLights",
          "module": "control.toggle",
          "config": {"label": "Navigation lights", "engrave": "NAV LIGHTS"},
          "bind": {"value": "lights.nav"}
        },
        {
          "socket": "cabinLight",
          "module": "control.toggle",
          "config": {"label": "Cabin light: off / white / red (night)", "engrave": "CABIN", "positions": 3},
          "bind": {"value": "lights.cabin"}
        },
        {
          "socket": "wipers",
          "module": "control.toggle",
          "config": {"label": "Windscreen wipers", "engrave": "WIPERS"},
          "bind": {"value": "wipers.on"}
        },
        {
          "socket": "spotlight",
          "module": "control.toggle",
          "config": {"label": "Searchlight on/off", "engrave": "SPOT"},
          "bind": {"value": "searchlight.on"}
        },
        {
          "socket": "horn",
          "module": "control.push-button",
          "config": {"label": "Horn", "engrave": "HORN", "color": "#e0b020"},
          "bind": {"press": "horn.sound"}
        },
        {
          "socket": "heat",
          "module": "control.push-button",
          "config": {"label": "HEAT: glow plugs (hold)", "engrave": "HEAT", "color": "#e07020"},
          "bind": {"press": "ignition.heat"}
        },
        {
          "socket": "start",
          "module": "control.push-button",
          "config": {"label": "START (hold)", "engrave": "START", "color": "#3aa04a", "lit": {"key": "propulsion.state", "is": "running"}},
          "bind": {"press": "ignition.start"}
        },
        {"socket": "key", "module": "control.key-switch"},
        {"socket": "lamps", "module": "instrument.warning-lamps"},
        {"socket": "card", "module": "furniture.start-card"},
        {
          "socket": "spotJoystick",
          "module": "control.joystick",
          "config": {"label": "Searchlight joystick", "engrave": "SEARCHLIGHT", "knob": "#e0b020"}
        },
        {"socket": "speed", "module": "instrument.screen", "config": {"screen": "speed"}},
        {"socket": "heading", "module": "instrument.screen", "config": {"screen": "heading"}},
        {"socket": "rpm", "module": "instrument.screen", "config": {"screen": "rpm"}},
        {"socket": "engineMonitor", "module": "instrument.screen", "config": {"screen": "engineMonitor"}}
      ]
    },
    {"socket": "breakerPanel", "module": "panel.breakers"},
    {"socket": "batteryMaster", "module": "switch.battery-master"},
    {"socket": "batterySelector", "module": "switch.battery-selector"},
    {"socket": "vhf", "module": "radio.vhf"},
    {"socket": "doorIn", "module": "control.door-button", "config": {"label": "Cabin door: open / shut"}},
    {"socket": "doorOut", "module": "control.door-button", "config": {"label": "Cabin door: open / shut"}},
    {"socket": "engineHatch", "module": "fitting.hatch-cover", "config": {"engrave": "ENGINE"}, "bind": {"open": "hatch.engine.open"}},
    {"socket": "dipstick", "module": "tool.dipstick"},
    {"socket": "oilCan", "module": "tool.oil-can"},
    {"socket": "searchlight", "module": "deck.searchlight", "config": {"position": [0, 3.2, 1]}},
    {
      "socket": "navLights",
      "module": "light.navigation",
      "config": {"lights": {"masthead": [0, 4.17, 1.2], "port": [-1.08, 2.82, 0.9], "starboard": [1.08, 2.82, 0.9], "stern": [0, 1.55, 5.05]}}
    },
    {"socket": "cleatFwdPort", "module": "deck.cleat", "config": {"end": "bow", "side": -1, "stations": {"bow": -4.6, "stern": 4.7, "midship": 0}}},
    {"socket": "cleatFwdStbd", "module": "deck.cleat", "config": {"end": "bow", "side": 1, "stations": {"bow": -4.6, "stern": 4.7, "midship": 0}}},
    {"socket": "cleatAftPort", "module": "deck.cleat", "config": {"end": "stern", "side": -1, "stations": {"bow": -4.6, "stern": 4.7, "midship": 0}}},
    {"socket": "cleatAftStbd", "module": "deck.cleat", "config": {"end": "stern", "side": 1, "stations": {"bow": -4.6, "stern": 4.7, "midship": 0}}}
  ],
  "interlocks": [{"when": "hatch.engine.open == false", "disable": ["control:dipstick", "control:oilCan"], "message": "Open the engine hatch first."}]
}
