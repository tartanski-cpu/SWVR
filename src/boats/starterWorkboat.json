{
  "id": "vessel.starter-workboat",
  "version": 3,
  "name": "Workboat",
  "hull": "hull.workboat-12m",
  "modules": [
    {
      "socket": "helm",
      "module": "console.standard",
      "modules": [
        { "socket": "wheel", "module": "control.wheel" },
        { "socket": "throttle", "module": "control.throttle-lever" },
        { "socket": "navLights", "module": "control.toggle", "config": { "label": "Navigation lights", "engrave": "NAV LIGHTS" }, "bind": { "value": "lights.nav" } },
        { "socket": "cabinLight", "module": "control.toggle", "config": { "label": "Cabin light: off / white / red (night)", "engrave": "CABIN", "positions": 3 }, "bind": { "value": "lights.cabin" } },
        { "socket": "wipers", "module": "control.toggle", "config": { "label": "Windscreen wipers", "engrave": "WIPERS" }, "bind": { "value": "wipers.on" } },
        { "socket": "firePump", "module": "control.toggle", "config": { "label": "FIRE PUMP (needs the engine running)", "engrave": "FIRE PUMP" }, "bind": { "value": "firePump.on" } },
        { "socket": "spotlight", "module": "control.toggle", "config": { "label": "Searchlight on/off", "engrave": "SPOT" }, "bind": { "value": "searchlight.on" } },
        { "socket": "horn", "module": "control.push-button", "config": { "label": "Horn", "engrave": "HORN", "color": "#e0b020" }, "bind": { "press": "horn.sound" } },
        { "socket": "anchor", "module": "control.toggle", "config": { "label": "Anchor: let go / heave in", "engrave": "ANCHOR" }, "bind": { "value": "anchor.letGo" } },
        { "socket": "trawl", "module": "control.toggle", "config": { "label": "TRAWL: shoot / haul the net", "engrave": "TRAWL" }, "bind": { "value": "trawl.shoot" } },
        { "socket": "heat", "module": "control.push-button", "config": { "label": "HEAT: glow plugs (hold)", "engrave": "HEAT", "color": "#e07020" }, "bind": { "press": "ignition.heat" } },
        { "socket": "start", "module": "control.push-button", "config": { "label": "START (hold)", "engrave": "START", "color": "#3aa04a", "lit": { "key": "propulsion.state", "is": "running" } }, "bind": { "press": "ignition.start" } },
        { "socket": "key", "module": "control.key-switch" },
        { "socket": "lamps", "module": "instrument.warning-lamps" },
        { "socket": "card", "module": "furniture.start-card" },
        { "socket": "spotJoystick", "module": "control.joystick", "config": { "label": "Searchlight joystick", "engrave": "SEARCHLIGHT", "knob": "#e0b020" } },
        { "socket": "monJoystick", "module": "control.joystick", "config": { "label": "Fire monitor joystick", "engrave": "MONITOR", "knob": "#d8301a", "panRateDeg": 40 }, "bind": { "pan": "monitor.pan", "tilt": "monitor.tilt" } },
        { "socket": "speed", "module": "instrument.screen", "config": { "screen": "speed" } },
        { "socket": "heading", "module": "instrument.screen", "config": { "screen": "heading" } },
        { "socket": "rpm", "module": "instrument.screen", "config": { "screen": "rpm" } },
        { "socket": "rudder", "module": "instrument.screen", "config": { "screen": "rudder" } },
        { "socket": "engineMonitor", "module": "instrument.screen", "config": { "screen": "engineMonitor" } }
      ]
    },
    { "socket": "navDisplay", "module": "instrument.screen", "config": { "screen": "nav", "mount": "hung" } },
    {
      "socket": "overhead",
      "module": "panel.overhead",
      "modules": [
        { "socket": "deckFore", "module": "control.toggle", "config": { "label": "Foredeck floodlight" }, "bind": { "value": "lights.deckFore" } },
        { "socket": "deckAft", "module": "control.toggle", "config": { "label": "Aft deck floodlight" }, "bind": { "value": "lights.deckAft" } },
        { "socket": "railLights", "module": "control.toggle", "config": { "label": "Rail lights" }, "bind": { "value": "lights.rail" } },
        { "socket": "fm", "module": "radio.fm" }
      ]
    },
    { "socket": "breakerPanel", "module": "panel.breakers" },
    { "socket": "batteryMaster", "module": "switch.battery-master" },
    { "socket": "batterySelector", "module": "switch.battery-selector" }
  ]
}
