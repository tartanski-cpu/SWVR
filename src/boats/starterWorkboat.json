{
  "id": "vessel.starter-workboat",
  "version": 10,
  "name": "Workboat",
  "hull": "hull.workboat-12m",
  "modules": [
    { "socket": "engine", "module": "propulsion.diesel-inboard" },
    { "socket": "rudder", "module": "steering.rudder" },
    { "socket": "fuelTank", "module": "fuel.tank" },
    { "socket": "batteries", "module": "electrical.battery-bank" },
    { "socket": "hydraulicPump", "module": "hydraulics.pto-pump" },
    { "socket": "bilgePump", "module": "pump.bilge" },
    { "socket": "floodFore", "module": "light.flood", "config": { "end": "fore" }, "bind": { "on": "lights.deckFore" } },
    { "socket": "floodAft", "module": "light.flood", "config": { "end": "aft" }, "bind": { "on": "lights.deckAft" } },
    { "socket": "railLights", "module": "light.rail" },
    { "socket": "cabinLight", "module": "light.cabin" },
    { "socket": "horn", "module": "electrical.consumer", "config": { "label": "Horn", "amps": 10, "circuit": null }, "bind": { "on": "horn.sound" } },
    { "socket": "wipers", "module": "electrical.consumer", "config": { "label": "Wiper motor", "amps": 4, "circuit": "instruments" }, "bind": { "on": "wipers.on" } },
    {
      "socket": "helm",
      "module": "console.standard",
      "modules": [
        { "socket": "wheel", "module": "control.wheel" },
        { "socket": "throttle", "module": "control.throttle-lever" },
        { "socket": "navLights", "module": "control.toggle", "config": { "label": "Navigation lights", "engrave": "NAV LIGHTS" }, "bind": { "value": "lights.nav" } },
        { "socket": "cabinLight", "module": "control.toggle", "config": { "label": "Cabin light: off / white / red (night)", "engrave": "CABIN", "positions": 3 }, "bind": { "value": "lights.cabin" } },
        { "socket": "wipers", "module": "control.toggle", "config": { "label": "Windscreen wipers", "engrave": "WIPERS" }, "bind": { "value": "wipers.on" } },
        { "socket": "firePump", "module": "control.toggle", "config": { "label": "FIRE PUMP (needs the engine running)", "engrave": "FIRE PUMP" }, "bind": { "value": "firePump.on" } },
        { "socket": "spotlight", "module": "control.toggle", "config": { "label": "Searchlight on/off", "engrave": "SPOT" }, "bind": { "value": "searchlight.on" } },
        { "socket": "horn", "module": "control.push-button", "config": { "label": "Horn", "engrave": "HORN", "color": "#e0b020" }, "bind": { "press": "horn.sound" } },
        { "socket": "anchor", "module": "control.toggle", "config": { "label": "Anchor: let go / heave in", "engrave": "ANCHOR" }, "bind": { "value": "anchor.letGo" } },
        { "socket": "trawl", "module": "control.toggle", "config": { "label": "TRAWL: shoot / haul the net", "engrave": "TRAWL" }, "bind": { "value": "trawl.shoot" } },
        { "socket": "heat", "module": "control.push-button", "config": { "label": "HEAT: glow plugs (hold)", "engrave": "HEAT", "color": "#e07020" }, "bind": { "press": "ignition.heat" } },
        { "socket": "start", "module": "control.push-button", "config": { "label": "START (hold)", "engrave": "START", "color": "#3aa04a", "lit": { "key": "propulsion.state", "is": "running" } }, "bind": { "press": "ignition.start" } },
        { "socket": "key", "module": "control.key-switch" },
        { "socket": "lamps", "module": "instrument.warning-lamps" },
        { "socket": "card", "module": "furniture.start-card" },
        { "socket": "spotJoystick", "module": "control.joystick", "config": { "label": "Searchlight joystick", "engrave": "SEARCHLIGHT", "knob": "#e0b020" } },
        { "socket": "monJoystick", "module": "control.joystick", "config": { "label": "Fire monitor joystick", "engrave": "MONITOR", "knob": "#d8301a", "panRateDeg": 40 }, "bind": { "pan": "monitor.pan", "tilt": "monitor.tilt" } },
        { "socket": "speed", "module": "instrument.screen", "config": { "screen": "speed" } },
        { "socket": "heading", "module": "instrument.screen", "config": { "screen": "heading" } },
        { "socket": "rpm", "module": "instrument.screen", "config": { "screen": "rpm" } },
        { "socket": "rudder", "module": "instrument.screen", "config": { "screen": "rudder" } },
        { "socket": "engineMonitor", "module": "instrument.screen", "config": { "screen": "engineMonitor" } }
      ]
    },
    { "socket": "navDisplay", "module": "instrument.screen", "config": { "screen": "nav", "mount": "hung" } },
    {
      "socket": "overhead",
      "module": "panel.overhead",
      "modules": [
        { "socket": "deckFore", "module": "control.toggle", "config": { "label": "Foredeck floodlight" }, "bind": { "value": "lights.deckFore" } },
        { "socket": "deckAft", "module": "control.toggle", "config": { "label": "Aft deck floodlight" }, "bind": { "value": "lights.deckAft" } },
        { "socket": "railLights", "module": "control.toggle", "config": { "label": "Rail lights" }, "bind": { "value": "lights.rail" } },
        { "socket": "fm", "module": "radio.fm" }
      ]
    },
    { "socket": "breakerPanel", "module": "panel.breakers" },
    { "socket": "batteryMaster", "module": "switch.battery-master" },
    { "socket": "batterySelector", "module": "switch.battery-selector" },
    { "socket": "vhf", "module": "radio.vhf" },
    { "socket": "chartplotter", "module": "nav.chartplotter" },
    { "socket": "chartTable", "module": "furniture.chart-table" },
    { "socket": "dutyBoard", "module": "furniture.duty-board" },
    { "socket": "whiteboard", "module": "furniture.whiteboard" },
    { "socket": "doorIn", "module": "control.door-button" },
    { "socket": "doorOut", "module": "control.door-button" },
    { "socket": "sideDoorIn", "module": "control.door-button", "config": { "label": "Side door: open / shut" }, "bind": { "door": "door.side.open" } },
    { "socket": "sideDoorOut", "module": "control.door-button", "config": { "label": "Side door: open / shut" }, "bind": { "door": "door.side.open" } },
    { "socket": "sideGateIn", "module": "control.door-button", "config": { "label": "Deck gate: open / shut" }, "bind": { "door": "gate.side.open" } },
    { "socket": "sideGateOut", "module": "control.door-button", "config": { "label": "Deck gate: open / shut" }, "bind": { "door": "gate.side.open" } },
    { "socket": "engineHatch", "module": "fitting.hatch-cover", "config": { "engrave": "ENGINE" }, "bind": { "open": "hatch.engine.open" } },
    { "socket": "dipstick", "module": "tool.dipstick" },
    { "socket": "oilCan", "module": "tool.oil-can" },
    { "socket": "tenderCrane", "module": "deck.tender-crane" },
    { "socket": "anchor", "module": "deck.anchor-windlass" },
    { "socket": "towWinch", "module": "deck.tow-winch" },
    { "socket": "sternRoller", "module": "deck.stern-roller" },
    { "socket": "aFrame", "module": "deck.a-frame" },
    { "socket": "trawl", "module": "fishing.trawl" },
    { "socket": "searchlight", "module": "deck.searchlight" },
    { "socket": "fireMonitor", "module": "deck.fire-monitor" },
    { "socket": "cleatFwdPort", "module": "deck.cleat", "config": { "end": "bow", "side": -1 } },
    { "socket": "cleatFwdStbd", "module": "deck.cleat", "config": { "end": "bow", "side": 1 } },
    { "socket": "cleatAftPort", "module": "deck.cleat", "config": { "end": "stern", "side": -1 } },
    { "socket": "cleatAftStbd", "module": "deck.cleat", "config": { "end": "stern", "side": 1 } },
    { "socket": "cleatMidPort", "module": "deck.cleat", "config": { "end": "midship", "side": -1 } },
    { "socket": "cleatMidStbd", "module": "deck.cleat", "config": { "end": "midship", "side": 1 } },
    { "socket": "fenders", "module": "deck.fenders" },
    { "socket": "swimLadder", "module": "deck.swim-ladder" },
    { "socket": "lifeRing", "module": "rescue.life-ring-station" },
    { "socket": "boatHook", "module": "rescue.boat-hook-rack" },
    {
      "socket": "mast",
      "module": "mount.mast",
      "modules": [
        { "socket": "masthead", "module": "light.navigation" }
      ]
    }
  ],
  "interlocks": [
    { "when": "hatch.engine.open == false", "disable": ["control:dipstick", "control:oilCan"], "message": "Open the engine hatch first." }
  ]
}
