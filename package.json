{
  "name": "swvr",
  "private": true,
  "version": "0.1.0",
  "description": "Browser-based VR sea rescue and operations game (WebXR + Three.js)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:shipyard": "vitest run tests/shipyard",
    "test:modules": "vitest run tests/modular",
    "test:training": "vitest run tests/training",
    "test:map": "vitest run tests/coast tests/currents tests/places tests/regions tests/regionView tests/skyline tests/surf tests/trees tests/voyagePlace tests/trafficCoast",
    "trials": "vitest run tests/seaTrials.test.ts --silent=false",
    "crewcheck": "node tools/crewCheck.mjs"
  },
  "dependencies": {
    "peerjs": "1.5.4",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
